generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  pages     Page[]

  @@map("workspaces")
}

model Page {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  title       String    @default("Untitled")
  icon        String?
  coverImage  String?   @map("cover_image")
  isArchived  Boolean   @default(false) @map("is_archived")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  blocks      Block[]
  parent      Page?     @relation("PageHierarchy", fields: [parentId], references: [id])
  children    Page[]    @relation("PageHierarchy")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("pages")
}

model Block {
  id            String   @id @default(uuid()) @db.Uuid
  pageId        String   @map("page_id") @db.Uuid
  parentBlockId String?  @map("parent_block_id") @db.Uuid
  type          String
  content       Json     @default("{}")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentBlock   Block?   @relation("BlockHierarchy", fields: [parentBlockId], references: [id], onDelete: Cascade)
  children      Block[]  @relation("BlockHierarchy")
  drawing       Drawing?

  @@map("blocks")
}

model Drawing {
  id             String   @id @default(uuid()) @db.Uuid
  blockId        String   @unique @map("block_id") @db.Uuid
  tldrawDocument Json     @default("{}") @map("tldraw_document")
  thumbnail      String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  block          Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@map("drawings")
}
