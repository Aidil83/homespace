generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  pages     Page[]

  @@map("workspaces")
}

model Page {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  title       String    @default("Untitled")
  icon        String?
  coverImage  String?   @map("cover_image")
  isArchived  Boolean   @default(false) @map("is_archived")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  blocks      Block[]
  parent      Page?     @relation("PageHierarchy", fields: [parentId], references: [id])
  children    Page[]    @relation("PageHierarchy")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("pages")
}

model Block {
  id            String   @id @default(uuid()) @db.Uuid
  pageId        String   @map("page_id") @db.Uuid
  parentBlockId String?  @map("parent_block_id") @db.Uuid
  type          String
  content       Json     @default("{}")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentBlock   Block?   @relation("BlockHierarchy", fields: [parentBlockId], references: [id], onDelete: Cascade)
  children      Block[]  @relation("BlockHierarchy")
  drawing       Drawing?

  @@map("blocks")
}

model Drawing {
  id             String   @id @default(uuid()) @db.Uuid
  blockId        String   @unique @map("block_id") @db.Uuid
  tldrawDocument Json     @default("{}") @map("tldraw_document")
  thumbnail      String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  block          Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@map("drawings")
}

// ========================================
// DSA Challenge Platform
// ========================================

model ProblemCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  problems    Problem[]

  @@map("problem_categories")
}

model Problem {
  id           String          @id @default(uuid()) @db.Uuid
  categoryId   String          @map("category_id") @db.Uuid
  title        String
  slug         String          @unique
  difficulty   String
  description  String
  examples     Json            @default("[]")
  constraints  Json            @default("[]")
  starterCode  Json            @default("{}") @map("starter_code")
  testCases    Json            @default("[]") @map("test_cases")
  hints        Json            @default("[]")
  solutionCode Json?           @map("solution_code")
  functionName String          @map("function_name")
  sortOrder    Int             @default(0) @map("sort_order")
  isPublished  Boolean         @default(true) @map("is_published")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category     ProblemCategory @relation(fields: [categoryId], references: [id])
  submissions  Submission[]
  userProgress UserProblemProgress[]

  @@map("problems")
}

model Submission {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  problemId   String   @map("problem_id") @db.Uuid
  language    String
  code        String
  status      String
  passedTests Int      @default(0) @map("passed_tests")
  totalTests  Int      @default(0) @map("total_tests")
  runtime     Int?
  memory      Int?
  errorOutput String?  @map("error_output")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
  @@index([userId, createdAt])
  @@map("submissions")
}

model UserProblemProgress {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  problemId    String    @map("problem_id") @db.Uuid
  status       String    @default("not_started")
  attempts     Int       @default(0)
  lastLanguage String?   @map("last_language")
  lastCode     String?   @map("last_code")
  solvedAt     DateTime? @map("solved_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  problem      Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@map("user_problem_progress")
}

model DailyChallengeCompletion {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  date       DateTime @db.Date
  difficulty String
  problemId  String   @map("problem_id")
  elapsedSec Int      @default(0) @map("elapsed_sec")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, date, difficulty])
  @@index([userId])
  @@map("daily_challenge_completions")
}

model NeetcodeProgress {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  problemId  String   @map("problem_id")
  elapsedSec Int      @default(0) @map("elapsed_sec")
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, problemId])
  @@index([userId])
  @@map("neetcode_progress")
}
